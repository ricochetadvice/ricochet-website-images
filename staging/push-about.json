{"about": "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=PT+Sans:wght@400;700&family=PT+Serif:wght@700&display=swap\">\n<style>\nbody{margin:0}\n.rico-page{font-family:'PT Sans',-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;color:#333}\n.rico-page *,.rico-page *::before,.rico-page *::after{box-sizing:border-box}\n.rico-page h1,.rico-page h2,.rico-page h3,.rico-page p,.rico-page figure,.rico-page ul{margin-top:0}\n.rico-page a{transition:opacity .15s}\n.rico-page a:hover{opacity:.85}\n.rico-page a:focus-visible{outline:3px solid #F0A500;outline-offset:3px}\n.rico-page img{max-width:100%}\n.rico-track{animation:rico-scroll 120s linear infinite}\n.rico-marquee:hover .rico-track,.rico-marquee:focus-within .rico-track{animation-play-state:paused}\n@keyframes rico-scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}\n@media (prefers-reduced-motion:reduce){.rico-track{animation:none}.rico-marquee{overflow-x:auto!important}}\n@media (max-width:1023px){.rico-page [style*=\"flex: 0 0 520px\"]{flex:1 1 100%!important}.rico-page section>div[style*=\"display: flex\"]:not([style*=\"flex-direction: column\"]){flex-wrap:wrap!important}}\n@media (max-width:767px){\n.rico-page header>div,.rico-page section>div,.rico-page footer>div{padding-left:20px!important;padding-right:20px!important;padding-top:56px!important;padding-bottom:56px!important}\n.rico-page header>div,.rico-page footer>div{padding-top:20px!important;padding-bottom:20px!important}\n.rico-page h1{font-size:42px!important;line-height:1.1!important}\n.rico-page h2:not(#logos-h){font-size:32px!important;line-height:1.18!important}\n.rico-page li[style*=\"flex: 1 1 200px\"]{flex:1 1 calc(50% - 12px)!important}\n.rico-page header nav{gap:14px 18px!important}\n.rico-page [style*=\"flex: 0 0 520px\"]{flex:1 1 100%!important}\n.rico-page section>div[style*=\"display: flex\"]:not([style*=\"flex-direction: column\"]){flex-wrap:wrap!important}\n.rico-page section{overflow-x:hidden}\n.rico-page [style*=\"grid-template-columns: repeat(3\"]{grid-template-columns:1fr!important}\n.rico-page [style*=\"flex: 1 1 4\"],.rico-page [style*=\"flex: 1 1 5\"],.rico-page [style*=\"flex: 0 1 4\"],.rico-page [style*=\"flex: 7 1\"],.rico-page [style*=\"flex: 5 1\"]{flex-basis:100%!important}\n.rico-page img[style*=\"max-width: none\"]{width:100%!important;margin-left:0!important}\n\n.rico-page figure>div[style*=\"padding: 40px 44px\"]{padding:28px 22px!important}\n.rico-page figure div[style*=\"gap: 32px; align-items: center\"]{flex-wrap:wrap!important}\n.rico-page [style*=\"overflow: hidden; display: flex;\"]{flex-direction:column!important}\n.rico-page img[style*=\"flex: 0 0 280px\"]{flex:none!important;width:100%!important;height:200px!important}\n.rico-page div[style*=\"padding: 40px 40px 42px\"]{padding:26px 22px 28px!important}\n.rico-page ol[style*=\"display: flex\"]{display:grid!important;grid-template-columns:1fr 1fr;gap:28px 16px!important}\n.rico-page div[style*=\"position: relative;\"]>img[aria-hidden=\"true\"][style*=\"position: absolute\"]{display:none!important}\n.rico-page div[style*=\"display: flex;\"]>div[style*=\"flex: 2 1 0\"]{display:none!important}\n}\n</style><div class=\"rico-page\" style=\"background:#FFFFFF;\"><header style=\"background: #041F33; font-family: 'PT Sans', -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; color: #FFFFFF;\">\n<div style=\"max-width: 1280px; margin: 0 auto; padding: 24px 48px; box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap;\">\n<a href=\"/\" aria-label=\"Ricochet Association Transformation, home\" style=\"display: block;\"><img src=\"/wp-content/uploads/2026/10/ricochet-association-transformation-logo-white.webp\" alt=\"Ricochet Association Transformation\" style=\"height: 44px; width: auto; display: block;\"></a>\n<nav aria-label=\"Main\" style=\"display: flex; gap: 28px; align-items: center; flex-wrap: wrap;\">\n<a href=\"/services/\" style=\"color: #FFFFFF; font-weight: 700; font-size: 16px; text-decoration: none;\">Services</a>\n<a href=\"/academy/\" style=\"color: #FFFFFF; font-weight: 700; font-size: 16px; text-decoration: none;\">Academy</a>\n<a href=\"/mailchimp/\" style=\"color: #FFFFFF; font-weight: 700; font-size: 16px; text-decoration: none;\">Mailchimp</a>\n<a href=\"/hubspot/\" style=\"color: #FFFFFF; font-weight: 700; font-size: 16px; text-decoration: none;\">HubSpot</a>\n<a href=\"/cases/\" style=\"color: #FFFFFF; font-weight: 700; font-size: 16px; text-decoration: none;\">Cases</a>\n<a href=\"/about/\" style=\"color: #FFFFFF; font-weight: 700; font-size: 16px; text-decoration: none;\">About</a>\n<a href=\"https://www.schedulechris.com\" style=\"display: inline-flex; align-items: center; min-height: 48px; padding: 0 24px; background: #D91A36; color: #FFFFFF; border-radius: 4px; font-weight: 700; font-size: 17px; text-decoration: none;\">Meet with us</a>\n</nav>\n</div>\n</header>\n<section style=\"position: relative; overflow: hidden; background: #D6EAF4; font-family: 'PT Sans', -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; color: #333333;\">\n<img src=\"/wp-content/uploads/2026/10/about-ricochet-hero-portfolio-compass-coffee.webp\" alt=\"A navy leather portfolio with a blank conference badge, a brass compass, a fountain pen and a cup of coffee.\" style=\"position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 100% center; display: block;\">\n<div style=\"position: relative; max-width: 1280px; margin: 0 auto; padding: 96px 48px; box-sizing: border-box; min-height: 810px; display: flex; align-items: center;\">\n<div style=\"flex: 0 1 580px; min-width: 0; display: flex; flex-direction: column; gap: 22px;\">\n<div style=\"font-weight: 700; font-size: 14px; line-height: 1; letter-spacing: 0.14em; text-transform: uppercase; color: #041F33;\">About Ricochet</div>\n<div style=\"width: 96px; height: 5px; background: linear-gradient(90deg, #D91A36 0%, #D91A36 10%, #E8763A 46%, #F0A500 86%, #F0A500 100%);\"></div>\n<h1 style=\"margin: 0; font-family: 'PT Serif', Georgia, serif; font-weight: 700; color: #041F33; font-size: 62px; line-height: 1.06; letter-spacing: -0.02em;\">Ricochet works only with associations.</h1>\n<p style=\"margin: 0; font-size: 22px; line-height: 1.55; color: #1F2D3A;\">For ten years, Ricochet has helped professional and trade associations grow membership, revenue and impact through marketing, technology and data.</p>\n<p style=\"margin: 0; font-size: 19px; line-height: 1.5; color: #1F2D3A;\">Want to talk it through? <a href=\"https://www.schedulechris.com\" style=\"color: #127196; font-weight: 700; text-decoration: none;\">Meet with us</a></p>\n</div></div></section>\n<section style=\"background: #FFFFFF; font-family: 'PT Sans', -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; color: #333333;\"><div style=\"max-width: 1280px; margin: 0 auto; padding: 96px 48px; box-sizing: border-box; display: flex; flex-direction: column; gap: 40px;\"><ul style=\"list-style: none; margin: 0; padding: 0; display: flex; gap: 72px; justify-content: center; align-items: center;\">\n<li><a href=\"https://ecosystem.hubspot.com/marketplace/solutions/ricochet\"><img src=\"/wp-content/uploads/2026/10/hubspot-partner-platinum-tier-badge.webp\" alt=\"HubSpot Partner, Platinum Tier.\" style=\"width: 220px; height: auto; display: block; filter: drop-shadow(0 12px 18px rgba(4,31,51,0.18));\"></a></li>\n<li><a href=\"https://mailchimp.com/find-an-expert/ricochet\"><img src=\"/wp-content/uploads/2026/10/mailchimp-partner-pro-tier-badge.webp\" alt=\"Mailchimp Partner, Pro Tier.\" style=\"width: 220px; height: auto; display: block; filter: drop-shadow(0 12px 18px rgba(4,31,51,0.18));\"></a></li>\n<li><a href=\"https://www.trustpilot.com/review/ricochetadvice.com\"><img src=\"/wp-content/uploads/2026/10/trustpilot-excellent-course-reviews-badge.webp\" alt=\"Rated Excellent with five stars in Trustpilot course reviews.\" style=\"width: 220px; height: auto; display: block; filter: drop-shadow(0 12px 18px rgba(4,31,51,0.18));\"></a></li>\n</ul></div></section>\n<section style=\"background: #F0EBE3; font-family: 'PT Sans', -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; color: #333333;\">\n<div style=\"max-width: 1280px; margin: 0 auto; padding: 96px 48px; box-sizing: border-box; display: flex; gap: 64px; align-items: stretch;\">\n<div style=\"flex: 0 0 440px; background: #D6EAF4; border-radius: 18px; overflow: hidden; display: flex; align-items: flex-end; justify-content: center; padding-top: 36px; min-height: 560px;\">\n<img src=\"/wp-content/uploads/2026/10/chris-gloede-cae-portrait.webp\" alt=\"Chris Gloede, Chief Consultant of Ricochet.\" style=\"width: 86%; height: auto; display: block;\">\n</div>\n<div style=\"flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: 18px; justify-content: center;\">\n<div style=\"font-weight: 700; font-size: 14px; line-height: 1; letter-spacing: 0.14em; text-transform: uppercase; color: #041F33;\">Leadership</div>\n<h2 style=\"margin: 0; font-family: 'PT Serif', Georgia, serif; font-weight: 700; color: #041F33; font-size: 44px; line-height: 1.16; letter-spacing: -0.02em;\">Who leads the work?</h2>\n<div style=\"display: flex; flex-direction: column; gap: 2px;\"><span style=\"font-family: 'PT Serif', Georgia, serif; font-weight: 700; color: #041F33; font-size: 26px;\">Chris Gloede, MBA, CAE</span><span style=\"font-size: 17px; font-weight: 700; color: #4B5563;\">Chief Consultant</span></div>\n<p style=\"margin: 0; font-size: 19px; line-height: 1.65; color: #333333;\">Before Ricochet, Chris served as the first Chief Marketing Officer of the American Bar Association, where he grew membership to its highest count in 137 years.</p>\n<p style=\"margin: 0; font-size: 19px; line-height: 1.65; color: #333333;\">Before the ABA, he worked at Ogilvy and Leo Burnett, driving marketing experiments for brands such as BP, Chrysler, Kraft and Unilever. Today he teaches live classes for association executives at the Association Academy.</p>\n<p style=\"margin: 0; font-size: 19px; line-height: 1.65; color: #333333;\">Chris holds the CAE credential and an MBA from the University of Chicago Booth School of Business. He once traveled for 53 weeks through 48 countries and 118 cities, chasing architecture and history.</p>\n<p style=\"margin: 6px 0 0; font-size: 18px; display: flex; gap: 26px;\"><a href=\"https://www.linkedin.com/in/chrisgloede/\" style=\"color: #127196; font-weight: 700; text-decoration: none;\">Connect with Chris on LinkedIn</a></p>\n</div></div></section>\n<section style=\"background: #FFFFFF; font-family: 'PT Sans', -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; color: #333333;\"><div style=\"max-width: 1280px; margin: 0 auto; padding: 96px 48px; box-sizing: border-box; display: flex; flex-direction: column; gap: 40px;\"><div style=\"display: flex; flex-direction: column; gap: 16px; max-width: 860px;\"><div style=\"font-weight: 700; font-size: 14px; line-height: 1; letter-spacing: 0.14em; text-transform: uppercase; color: #041F33;\">The team</div><h2 style=\"margin: 0; font-family: 'PT Serif', Georgia, serif; font-weight: 700; color: #041F33; font-size: 44px; line-height: 1.16; letter-spacing: -0.02em;\">Who will I work with?</h2><p style=\"margin: 0; font-size: 20px; line-height: 1.55;\">Most of the Ricochet team worked inside associations before working for them, so they understand volunteer governance and mission-driven decisions.</p></div>\n<ul style=\"list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 24px; justify-content: center;\"><li style=\"flex: 0 1 368px; min-width: 0; background: #FFFFFF; border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 10px 24px rgba(4,31,51,0.08);\">\n<div style=\"height: 280px; background: #D6EAF4 radial-gradient(ellipse 60% 68% at 50% 55%, #EAF4FA 0%, #E1EFF7 40%, #D6EAF4 78%); display: flex; align-items: flex-end; justify-content: center; overflow: hidden;\"><img src=\"/wp-content/uploads/2026/10/tom-felgar-headshot-cutout.webp\" alt=\"Tom Felgar, MBA.\" style=\"height: 262px; width: auto; display: block;\"></div>\n<div style=\"padding: 22px 24px 26px; display: flex; flex-direction: column; gap: 8px;\">\n<h3 style=\"margin: 0; font-family: 'PT Serif', Georgia, serif; font-weight: 700; color: #041F33; font-size: 23px; line-height: 1.2;\">Tom Felgar, MBA</h3>\n<span style=\"font-size: 15px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #4B5563;\">Solution Engineer</span>\n<p style=\"margin: 6px 0 0; font-size: 17px; line-height: 1.6;\">Tom has spent more than 15 years helping associations, nonprofits and schools adopt new marketing technology. He leads HubSpot implementations and their ongoing evolution. He previously worked at the American Academy of Dermatology and the American Bar Association, and he is a HubSpot Certified Trainer.</p></div></li><li style=\"flex: 0 1 368px; min-width: 0; background: #FFFFFF; border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 10px 24px rgba(4,31,51,0.08);\">\n<div style=\"height: 280px; background: #D6EAF4 radial-gradient(ellipse 60% 68% at 50% 55%, #EAF4FA 0%, #E1EFF7 40%, #D6EAF4 78%); display: flex; align-items: flex-end; justify-content: center; overflow: hidden;\"><img src=\"/wp-content/uploads/2026/10/laura-aguilar-headshot-cutout.webp\" alt=\"Laura Aguilar.\" style=\"height: 262px; width: auto; display: block;\"></div>\n<div style=\"padding: 22px 24px 26px; display: flex; flex-direction: column; gap: 8px;\">\n<h3 style=\"margin: 0; font-family: 'PT Serif', Georgia, serif; font-weight: 700; color: #041F33; font-size: 23px; line-height: 1.2;\">Laura Aguilar</h3>\n<span style=\"font-size: 15px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #4B5563;\">Analyst and Producer</span>\n<p style=\"margin: 6px 0 0; font-size: 17px; line-height: 1.6;\">Laura brings international digital marketing experience from B2B and B2C companies. At Ricochet she supports HubSpot implementation, marketing automation and design, and she leads production of the Association Academy courses.</p></div></li><li style=\"flex: 0 1 368px; min-width: 0; background: #FFFFFF; border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 10px 24px rgba(4,31,51,0.08);\">\n<div style=\"height: 280px; background: #D6EAF4 radial-gradient(ellipse 60% 68% at 50% 55%, #EAF4FA 0%, #E1EFF7 40%, #D6EAF4 78%); display: flex; align-items: flex-end; justify-content: center; overflow: hidden;\"><img src=\"/wp-content/uploads/2026/10/chelsea-forgille-headshot-cutout.webp\" alt=\"Chelsea Forgille.\" style=\"height: 262px; width: auto; display: block;\"></div>\n<div style=\"padding: 22px 24px 26px; display: flex; flex-direction: column; gap: 8px;\">\n<h3 style=\"margin: 0; font-family: 'PT Serif', Georgia, serif; font-weight: 700; color: #041F33; font-size: 23px; line-height: 1.2;\">Chelsea Forgille</h3>\n<span style=\"font-size: 15px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #4B5563;\">Consultant</span>\n<p style=\"margin: 6px 0 0; font-size: 17px; line-height: 1.6;\">Chelsea leads project management at Ricochet, carrying complex initiatives from kickoff to completion. She previously ran membership campaigns and marketing automation at the American Bar Association.</p></div></li><li style=\"flex: 0 1 368px; min-width: 0; background: #FFFFFF; border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 10px 24px rgba(4,31,51,0.08);\">\n<div style=\"height: 280px; background: #D6EAF4 radial-gradient(ellipse 60% 68% at 50% 55%, #EAF4FA 0%, #E1EFF7 40%, #D6EAF4 78%); display: flex; align-items: flex-end; justify-content: center; overflow: hidden;\"><img src=\"/wp-content/uploads/2026/10/stacy-jeziorowski-headshot-cutout.webp\" alt=\"Stacy Jeziorowski.\" style=\"height: 262px; width: auto; display: block;\"></div>\n<div style=\"padding: 22px 24px 26px; display: flex; flex-direction: column; gap: 8px;\">\n<h3 style=\"margin: 0; font-family: 'PT Serif', Georgia, serif; font-weight: 700; color: #041F33; font-size: 23px; line-height: 1.2;\">Stacy Jeziorowski</h3>\n<span style=\"font-size: 15px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #4B5563;\">Consultant</span>\n<p style=\"margin: 6px 0 0; font-size: 17px; line-height: 1.6;\">Stacy has more than 15 years in association marketing and communications. She led a full rebrand as Marketing and Communications Lead at the Computer Science Teachers Association, and at Ricochet she leads client membership and event strategy and campaigns.</p></div></li><li style=\"flex: 0 1 368px; min-width: 0; background: #FFFFFF; border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 10px 24px rgba(4,31,51,0.08);\">\n<div style=\"height: 280px; background: #D6EAF4 radial-gradient(ellipse 60% 68% at 50% 55%, #EAF4FA 0%, #E1EFF7 40%, #D6EAF4 78%); display: flex; align-items: flex-end; justify-content: center; overflow: hidden;\"><img src=\"/wp-content/uploads/2026/10/fernando-velarde-headshot-cutout.webp\" alt=\"Fernando Velarde.\" style=\"height: 262px; width: auto; display: block;\"></div>\n<div style=\"padding: 22px 24px 26px; display: flex; flex-direction: column; gap: 8px;\">\n<h3 style=\"margin: 0; font-family: 'PT Serif', Georgia, serif; font-weight: 700; color: #041F33; font-size: 23px; line-height: 1.2;\">Fernando Velarde</h3>\n<span style=\"font-size: 15px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #4B5563;\">Creative Director</span>\n<p style=\"margin: 6px 0 0; font-size: 17px; line-height: 1.6;\">Fernando brings two decades of UI/UX architecture and web design. He delivers branding and design at speed, and he led design for major summits including CERF 2025 and the SACUBO Annual Meeting.</p></div></li></ul></div></section>\n<section style=\"background: #F0EBE3; font-family: 'PT Sans', -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; color: #333333;\"><div style=\"max-width: 1280px; margin: 0 auto; padding: 96px 48px; box-sizing: border-box; display: flex; flex-direction: column; gap: 40px;\"><div style=\"display: flex; flex-direction: column; gap: 16px; max-width: 860px;\"><div style=\"font-weight: 700; font-size: 14px; line-height: 1; letter-spacing: 0.14em; text-transform: uppercase; color: #041F33;\">Explore</div><h2 style=\"margin: 0; font-family: 'PT Serif', Georgia, serif; font-weight: 700; color: #041F33; font-size: 44px; line-height: 1.16; letter-spacing: -0.02em;\">Where else can I get to know Ricochet?</h2></div>\n<ul style=\"list-style: none; margin: 0; padding: 0; display: flex; gap: 24px; align-items: stretch;\"><li style=\"flex: 1 1 0; min-width: 0; background: #FFFFFF; border-radius: 16px; padding: 26px 28px 28px; display: flex; flex-direction: column; gap: 10px;\">\n<img src=\"/wp-content/uploads/2026/10/easel-chart-icon.webp\" alt=\"A small easel holding a chart.\" style=\"width: 104px; height: 104px; object-fit: contain; display: block; mix-blend-mode: multiply; margin-left: -8px;\">\n<h3 style=\"margin: 0; font-family: 'PT Serif', Georgia, serif; font-weight: 700; color: #041F33; font-size: 24px; line-height: 1.15;\">Cases</h3><p style=\"margin: 0; font-size: 17px; line-height: 1.5;\">See what associations like mine have achieved.</p>\n<span style=\"margin-top: auto; padding-top: 6px;\"><a href=\"/cases/\" style=\"color: #127196; font-weight: 700; text-decoration: none;\">Read the cases</a></span></li><li style=\"flex: 1 1 0; min-width: 0; background: #FFFFFF; border-radius: 16px; padding: 26px 28px 28px; display: flex; flex-direction: column; gap: 10px;\">\n<img src=\"/wp-content/uploads/2026/10/tech-stack-conference-management-icon.webp\" alt=\"A desk calendar.\" style=\"width: 104px; height: 104px; object-fit: contain; display: block; mix-blend-mode: multiply; margin-left: -8px;\">\n<h3 style=\"margin: 0; font-family: 'PT Serif', Georgia, serif; font-weight: 700; color: #041F33; font-size: 24px; line-height: 1.15;\">Events</h3><p style=\"margin: 0; font-size: 17px; line-height: 1.5;\">Find Ricochet at association conventions and coffee meetups.</p>\n<span style=\"margin-top: auto; padding-top: 6px;\"><a href=\"/events/\" style=\"color: #127196; font-weight: 700; text-decoration: none;\">See the events</a></span></li><li style=\"flex: 1 1 0; min-width: 0; background: #FFFFFF; border-radius: 16px; padding: 26px 28px 28px; display: flex; flex-direction: column; gap: 10px;\">\n<img src=\"/wp-content/uploads/2026/10/light-bulb-icon.webp\" alt=\"A light bulb.\" style=\"width: 104px; height: 104px; object-fit: contain; display: block; mix-blend-mode: multiply; margin-left: -8px;\">\n<h3 style=\"margin: 0; font-family: 'PT Serif', Georgia, serif; font-weight: 700; color: #041F33; font-size: 24px; line-height: 1.15;\">Association Academy</h3><p style=\"margin: 0; font-size: 17px; line-height: 1.5;\">Earn continuing education credit in live certificate courses.</p>\n<span style=\"margin-top: auto; padding-top: 6px;\"><a href=\"/academy/\" style=\"color: #127196; font-weight: 700; text-decoration: none;\">Explore courses</a></span></li></ul></div></section>\n<section style=\"background: #041F33; font-family: 'PT Sans', -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; color: #FFFFFF;\">\n<div style=\"max-width: 1280px; margin: 0 auto; padding: 96px 48px; box-sizing: border-box; display: flex; flex-direction: column; gap: 24px; align-items: flex-start;\">\n<div style=\"width: 96px; height: 5px; background: linear-gradient(90deg, #D91A36 0%, #D91A36 10%, #E8763A 46%, #F0A500 86%, #F0A500 100%);\"></div>\n<h2 style=\"margin: 0; max-width: 820px; font-family: 'PT Serif', Georgia, serif; font-weight: 700; font-size: 64px; line-height: 1.1; letter-spacing: -0.02em; color: #FFFFFF;\">Let's talk about your association</h2>\n<p style=\"margin: 0; max-width: 640px; font-size: 20px; line-height: 1.5; color: rgba(255,255,255,0.78);\">Bring your toughest question. We'll help you find the next step.</p>\n<a href=\"https://www.schedulechris.com\" style=\"display: inline-flex; align-items: center; min-height: 52px; padding: 0 28px; background: #D91A36; color: #FFFFFF; border-radius: 4px; font-weight: 700; font-size: 18px; text-decoration: none;\">Meet with us</a>\n</div>\n</section>\n<footer style=\"background: #041F33; border-top: 1px solid rgba(255,255,255,0.16); font-family: 'PT Sans', -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; color: #FFFFFF;\">\n<div style=\"max-width: 1280px; margin: 0 auto; padding: 32px 48px; box-sizing: border-box; display: flex; gap: 24px; flex-wrap: wrap; justify-content: space-between; align-items: center;\">\n<span style=\"font-size: 15px; color: rgba(255,255,255,0.72);\">Copyright \u00a9 2026 Ricochet Advisory Services, LLC. No AI training without written permission.</span>\n<nav aria-label=\"Legal\" style=\"display: flex; gap: 20px; flex-wrap: wrap;\">\n<a href=\"/terms_of_use_and_privacy_policy/\" style=\"color: #FFFFFF; font-weight: 700; font-size: 15px; text-decoration: none;\">Terms of Use</a>\n<a href=\"/terms_of_use_and_privacy_policy/\" style=\"color: #FFFFFF; font-weight: 700; font-size: 15px; text-decoration: none;\">Privacy Policy</a>\n<a href=\"/ams-connector-terms-of-service/\" style=\"color: #FFFFFF; font-weight: 700; font-size: 15px; text-decoration: none;\">Terms of Service AMS Connector</a>\n<a href=\"/terms-of-service-hubspot-preferences-portal/\" style=\"color: #FFFFFF; font-weight: 700; font-size: 15px; text-decoration: none;\">Terms of Service Preferences Portal</a>\n<a href=\"/trouble-receiving-email