{"ty-contact": {"title": "Let's Talk Thank You (new design)", "slug": "lets-talk-thank-you", "parent": 0, "content": "<!-- wp:html -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=PT+Sans:wght@400;700&family=PT+Serif:wght@700&display=swap\">\n<style>\nbody{margin:0}\n.rico-page{font-family:'PT Sans',-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;color:#333}\n.rico-page *,.rico-page *::before,.rico-page *::after{box-sizing:border-box}\n.rico-page h1,.rico-page h2,.rico-page h3,.rico-page p,.rico-page figure,.rico-page ul{margin-top:0}\n.rico-page a{transition:opacity .15s}\n.rico-page a:hover{opacity:.85}\n.rico-page a:focus-visible{outline:3px solid #F0A500;outline-offset:3px}\n.rico-page img{max-width:100%}\n.rico-track{animation:rico-scroll 120s linear infinite}\n.rico-marquee:hover .rico-track,.rico-marquee:focus-within .rico-track{animation-play-state:paused}\n@keyframes rico-scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}\n@media (prefers-reduced-motion:reduce){.rico-track{animation:none}.rico-marquee{overflow-x:auto!important}}\n@media (max-width:1023px){.rico-page [style*=\"flex: 0 0 520px\"]{flex:1 1 100%!important}.rico-page section>div[style*=\"display: flex\"]:not([style*=\"flex-direction: column\"]){flex-wrap:wrap!important}}\n@media (max-width:767px){\n.rico-page header>div,.rico-page section>div,.rico-page footer>div{padding-left:20px!important;padding-right:20px!important;padding-top:56px!important;padding-bottom:56px!important}\n.rico-page header>div,.rico-page footer>div{padding-top:20px!important;padding-bottom:20px!important}\n.rico-page h1{font-size:42px!important;line-height:1.1!important}\n.rico-page h2:not(#logos-h){font-size:32px!important;line-height:1.18!important}\n.rico-page li[style*=\"flex: 1 1 200px\"]{flex:1 1 calc(50% - 12px)!important}\n.rico-page header nav{gap:14px 18px!important}\n.rico-page [style*=\"flex: 0 0 520px\"]{flex:1 1 100%!important}\n.rico-page section>div[style*=\"display: flex\"]:not([style*=\"flex-direction: column\"]){flex-wrap:wrap!important}\n.rico-page section{overflow-x:hidden}\n.rico-page [style*=\"grid-template-columns: repeat(3\"]{grid-template-columns:1fr!important}\n.rico-page [style*=\"flex: 1 1 4\"],.rico-page [style*=\"flex: 1 1 5\"],.rico-page [style*=\"flex: 0 1 4\"],.rico-page [style*=\"flex: 7 1\"],.rico-page [style*=\"flex: 5 1\"]{flex-basis:100%!important}\n.rico-page img[style*=\"max-width: none\"]{width:100%!important;margin-left:0!important}\n\n.rico-page figure>div[style*=\"padding: 40px 44px\"]{padding:28px 22px!important}\n.rico-page figure div[style*=\"gap: 32px; align-items: center\"]{flex-wrap:wrap!important}\n.rico-page [style*=\"overflow: hidden; display: flex;\"]{flex-direction:column!important}\n.rico-page img[style*=\"flex: 0 0 280px\"]{flex:none!important;width:100%!important;height:200px!important}\n.rico-page div[style*=\"padding: 40px 40px 42px\"]{padding:26px 22px 28px!important}\n.rico-page ol[style*=\"display: flex\"]{display:grid!important;grid-template-columns:1fr 1fr;gap:28px 16px!important}\n.rico-page div[style*=\"position: relative;\"]>img[aria-hidden=\"true\"][style*=\"position: absolute\"]{display:none!important}\n.rico-page div[style*=\"display: flex;\"]>div[style*=\"flex: 2 1 0\"]{display:none!important}\n}\n</style><div class=\"rico-page\" style=\"background:#FFFFFF;\"><header style=\"background: #041F33; font-family: 'PT Sans', -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; color: #FFFFFF;\">\n<div style=\"max-width: 1280px; margin: 0 auto; padding: 24px 48px; box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap;\">\n<a href=\"/\" aria-label=\"Ricochet Association Transformation, home\" style=\"display: block;\"><img src=\"/wp-content/uploads/2026/10/ricochet-association-transformation-logo-white.webp\" alt=\"Ricochet Association Transformation\" style=\"height: 44px; width: auto; display: block;\"></a>\n<nav aria-label=\"Main\" style=\"display: flex; gap: 28px; align-items: center; flex-wrap: wrap;\">\n<a href=\"/services/\" style=\"color: #FFFFFF; font-weight: 700; font-size: 16px; text-decoration: none;\">Services</a>\n<a href=\"/academy/\" style=\"color: #FFFFFF; font-weight: 700; font-size: 16px; text-decoration: none;\">Academy</a>\n<a href=\"/mailchimp/\" style=\"color: #FFFFFF; font-weight: 700; font-size: 16px; text-decoration: none;\">Mailchimp</a>\n<a href=\"/hubspot/\" style=\"color: #FFFFFF; font-weight: 700; font-size: 16px; text-decoration: none;\">HubSpot</a>\n<a href=\"/cases/\" style=\"color: #FFFFFF; font-weight: 700; font-size: 16px; text-decoration: none;\">Cases</a>\n<a href=\"/about/\" style=\"color: #FFFFFF; font-weight: 700; font-size: 16px; text-decoration: none;\">About</a>\n<a href=\"https://www.schedulechris.com\" style=\"display: inline-flex; align-items: center; min-height: 48px; padding: 0 24px; background: #D91A36; color: #FFFFFF; border-radius: 4px; font-weight: 700; font-size: 17px; text-decoration: none;\">Meet with us</a>\n</nav>\n</div>\n</header>\n<section style=\"position: relative; overflow: hidden; background: #D6EAF4; font-family: 'PT Sans', -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; color: #333333;\">\n<div style=\"position: relative; max-width: 1280px; margin: 0 auto; padding: 88px 48px 96px; box-sizing: border-box; min-height: 640px; display: flex; flex-wrap: wrap; gap: 64px; align-items: center;\">\n<div style=\"flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 22px;\">\n<div style=\"font-weight: 700; font-size: 14px; line-height: 1; letter-spacing: 0.14em; text-transform: uppercase; color: #041F33;\">Message received</div>\n<div style=\"width: 96px; height: 5px; background: linear-gradient(90deg, #D91A36 0%, #D91A36 10%, #E8763A 46%, #F0A500 86%, #F0A500 100%);\"></div>\n<h1 style=\"margin: 0; font-family: 'PT Serif', Georgia, serif; font-weight: 700; color: #041F33; font-size: 56px; line-height: 1.08; letter-spacing: -0.02em;\">Thank you for contacting Ricochet.</h1>\n<p style=\"margin: 0; font-size: 20px; line-height: 1.6; color: #1F2D3A;\">A member of the Ricochet team will reply to your note within one business day.</p>\n<div style=\"display: flex; flex-wrap: wrap; gap: 24px; align-items: center; padding-top: 6px;\">\n<a href=\"https://www.schedulechris.com\" style=\"display: inline-flex; align-items: center; min-height: 48px; box-sizing: border-box; background: #041F33; color: #FFFFFF; border-radius: 999px; padding: 14px 30px; font-weight: 700; font-size: 18px; text-decoration: none;\">Meet with us</a>\n<a href=\"/cases/\" style=\"display: inline-flex; align-items: center; min-height: 48px; color: #041F33; font-weight: 700; font-size: 18px; text-decoration: underline; text-underline-offset: 4px;\">See client cases</a>\n</div>\n</div>\n<div style=\"flex: 0 1 480px; min-width: 0; background: #FFFFFF; border-radius: 18px; padding: 34px 36px; box-shadow: 0 18px 40px rgba(4,31,51,0.14); display: flex; flex-direction: column; gap: 18px;\">\n<img src=\"/wp-content/uploads/2026/10/envelope-icon-tile.webp\" alt=\"\" aria-hidden=\"true\" style=\"width: 72px; height: 72px; display: block;\">\n<h2 style=\"margin: 0; font-family: 'PT Serif', Georgia, serif; font-weight: 700; color: #041F33; font-size: 26px;\">What happens next</h2>\n<p style=\"margin: 0; font-size: 18px; line-height: 1.55; color: #1F2D3A;\">Look for a confirmation email from <strong style=\"color: #041F33;\">Ricochet Association Transformation</strong> with a copy of your note.</p>\n<p style=\"margin: 0; padding-top: 16px; border-top: 1px solid rgba(4,31,51,0.16); font-size: 18px; line-height: 1.55; color: #1F2D3A;\">Want to talk sooner? Book a time with <a href=\"https://www.schedulechris.com\" style=\"color: #041F33; font-weight: 700;\">Meet with us</a> instead of waiting for a reply.</p>\n</div>\n</div></section>\n<footer style=\"background: #041F33; border-top: 1px solid rgba(255,255,255,0.16); font-family: 'PT Sans', -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; color: #FFFFFF;\">\n<div style=\"max-width: 1280px; margin: 0 auto; padding: 32px 48px; box-sizing: border-box; display: flex; gap: 24px; flex-wrap: wrap; justify-content: space-between; align-items: center;\">\n<span style=\"font-size: 15px; color: rgba(255,255,255,0.72);\">Copyright \u00a9 2026 Ricochet Advisory Services, LLC. No AI training without written permission.</span>\n<nav aria-label=\"Legal\" style=\"display: flex; gap: 20px; flex-wrap: wrap;\">\n<a href=\"/terms_of_use_and_privacy_policy/\" style=\"color: #FFFFFF; font-weight: 700; font-size: 15px; text-decoration: none;\">Terms of Use and Privacy Policy</a>\n<a href=\"/ams-connector-terms-of-service/\" style=\"color: #FFFFFF; font-weight: 700; font-size: 15px; text-decoration: none;\">Terms of Service AMS Connector</a>\n<a href=\"/terms-of-service-hubspot-preferences-portal/\" style=\"color: #FFFFFF; font-weight: 700; font-size: 15px; text-decoration: none;\">Terms of Service Preferences Portal</a>\n<a href=\"/trouble-receiving-emails-from-ricochet/\" style=\"color: #FFFFFF; font-weight: 700; font-size: 15px; text-decoration: none;\">Trouble Receiving Email</a>\n</nav>\n</div>\n</footer></div>\n<!-- /wp:html -->"}}