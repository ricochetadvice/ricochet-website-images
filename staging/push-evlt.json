{"events": "<!-- wp:html -->\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=PT+Sans:wght@400;700&family=PT+Serif:wght@700&display=swap\">\n<style>\nbody{margin:0}\n.rico-page{font-family:'PT Sans',-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;color:#333}\n.rico-page *,.rico-page *::before,.rico-page *::after{box-sizing:border-box}\n.rico-page h1,.rico-page h2,.rico-page h3,.rico-page p,.rico-page figure,.rico-page ul{margin-top:0}\n.rico-page a{transition:opacity .15s}\n.rico-page a:hover{opacity:.85}\n.rico-page a:focus-visible{outline:3px solid #F0A500;outline-offset:3px}\n.rico-page img{max-width:100%}\n.rico-track{animation:rico-scroll 120s linear infinite}\n.rico-marquee:hover .rico-track,.rico-marquee:focus-within .rico-track{animation-play-state:paused}\n@keyframes rico-scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}\n@media (prefers-reduced-motion:reduce){.rico-track{animation:none}.rico-marquee{overflow-x:auto!important}}\n@media (max-width:1023px){.rico-page [style*=\"flex: 0 0 520px\"]{flex:1 1 100%!important}.rico-page section>div[style*=\"display: flex\"]:not([style*=\"flex-direction: column\"]){flex-wrap:wrap!important}}\n@media (max-width:767px){\n.rico-page header>div,.rico-page section>div,.rico-page footer>div{padding-left:20px!important;padding-right:20px!important;padding-top:56px!important;padding-bottom:56px!important}\n.rico-page header>div,.rico-page footer>div{padding-top:20px!important;padding-bottom:20px!important}\n.rico-page h1{font-size:42px!important;line-height:1.1!important}\n.rico-page h2:not(#logos-h){font-size:32px!important;line-height:1.18!important}\n.rico-page li[style*=\"flex: 1 1 200px\"]{flex:1 1 calc(50% - 12px)!important}\n.rico-page header nav{gap:14px 18px!important}\n.rico-page [style*=\"flex: 0 0 520px\"]{flex:1 1 100%!important}\n.rico-page section>div[style*=\"display: flex\"]:not([style*=\"flex-direction: column\"]){flex-wrap:wrap!important}\n.rico-page section{overflow-x:hidden}\n.rico-page [style*=\"grid-template-columns: repeat(3\"]{grid-template-columns:1fr!important}\n.rico-page [style*=\"flex: 1 1 4\"],.rico-page [style*=\"flex: 1 1 5\"],.rico-page [style*=\"flex: 0 1 4\"],.rico-page [style*=\"flex: 7 1\"],.rico-page [style*=\"flex: 5 1\"]{flex-basis:100%!important}\n.rico-page img[style*=\"max-width: none\"]{width:100%!important;margin-left:0!important}\n\n.rico-page figure>div[style*=\"padding: 40px 44px\"]{padding:28px 22px!important}\n.rico-page figure div[style*=\"gap: 32px; align-items: center\"]{flex-wrap:wrap!important}\n.rico-page [style*=\"overflow: hidden; display: flex;\"]{flex-direction:column!important}\n.rico-page img[style*=\"flex: 0 0 280px\"]{flex:none!important;width:100%!important;height:200px!important}\n.rico-page div[style*=\"padding: 40px 40px 42px\"]{padding:26px 22px 28px!important}\n.rico-page ol[style*=\"display: flex\"]{display:grid!important;grid-template-columns:1fr 1fr;gap:28px 16px!important}\n.rico-page div[style*=\"position: relative;\"]>img[aria-hidden=\"true\"][style*=\"position: absolute\"]{display:none!important}\n.rico-page div[style*=\"display: flex;\"]>div[style*=\"flex: 2 1 0\"]{display:none!important}\n}\n</style><div class=\"rico-page\" style=\"background:#FFFFFF;\"><header style=\"background: #041F33; font-family: 'PT Sans', -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; color: #FFFFFF;\">\n<div style=\"max-width: 1280px; margin: 0 auto; padding: 24px 48px; box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap;\">\n<a href=\"/\" aria-label=\"Ricochet Association Transformation, home\" style=\"display: block;\"><img src=\"/wp-content/uploads/2026/10/ricochet-association-transformation-logo-white.webp\" alt=\"Ricochet Association Transformation\" style=\"height: 44px; width: auto; display: block;\"></a>\n<nav aria-label=\"Main\" style=\"display: flex; gap: 28px; align-items: center; flex-wrap: wrap;\">\n<a href=\"/services/\" style=\"color: #FFFFFF; font-weight: 700; font-size: 16px; text-decoration: none;\">Services</a>\n<a href=\"/academy/\" style=\"color: #FFFFFF; font-weight: 700; font-size: 16px; text-decoration: none;\">Academy</a>\n<a href=\"/mailchimp/\" style=\"color: #FFFFFF; font-weight: 700; font-size: 16px; text-decoration: none;\">Mailchimp</a>\n<a href=\"/hubspot/\" style=\"color: #FFFFFF; font-weight: 700; font-size: 16px; text-decoration: none;\">HubSpot</a>\n<a href=\"/cases/\" style=\"color: #FFFFFF; font-weight: 700; font-size: 16px; text-decoration: none;\">Cases</a>\n<a href=\"/about/\" style=\"color: #FFFFFF; font-weight: 700; font-size: 16px; text-decoration: none;\">About</a>\n<a href=\"https://www.schedulechris.com\" style=\"display: inline-flex; align-items: center; min-height: 48px; padding: 0 24px; background: #D91A36; color: #FFFFFF; border-radius: 4px; font-weight: 700; font-size: 17px; text-decoration: none;\">Meet with us</a>\n</nav>\n</div>\n</header>\n<section style=\"position: relative; overflow: hidden; background: #D6EAF4; font-family: 'PT Sans', -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; color: #333333;\">\n<img src=\"/wp-content/uploads/2026/10/events-hero-microphone-badge-program.webp\" alt=\"A navy handheld microphone, a blank conference badge on a lanyard, a coffee cup, an event program blind-embossed with the Ricochet R and a brass desk bell.\" style=\"position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 100% center; display: block;\">\n<div style=\"position: relative; max-width: 1280px; margin: 0 auto; padding: 96px 48px; box-sizing: border-box; min-height: 810px; display: flex; align-items: center;\">\n<div style=\"flex: 0 1 580px; min-width: 0; display: flex; flex-direction: column; gap: 22px;\">\n<div style=\"font-weight: 700; font-size: 14px; line-height: 1; letter-spacing: 0.14em; text-transform: uppercase; color: #041F33;\">Events</div>\n<div style=\"width: 96px; height: 5px; background: linear-gradient(90deg, #D91A36 0%, #D91A36 10%, #E8763A 46%, #F0A500 86%, #F0A500 100%);\"></div>\n<h1 style=\"margin: 0; font-family: 'PT Serif', Georgia, serif; font-weight: 700; color: #041F33; font-size: 62px; line-height: 1.06; letter-spacing: -0.02em;\">Where can I meet Ricochet in person?</h1>\n<p style=\"margin: 0; font-size: 22px; line-height: 1.55; color: #1F2D3A;\">Catch Ricochet at association conventions and private events, or join a weekly Association Academy course online.</p>\n<p style=\"margin: 0; font-size: 19px; line-height: 1.5; color: #1F2D3A;\">Want Chris at your event? <a href=\"/lets-talk/\" style=\"color: #127196; font-weight: 700; text-decoration: none;\">Let's chat</a></p>\n</div></div></section>\n<section style=\"background: #FFFFFF; font-family: 'PT Sans', -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; color: #333333;\"><div style=\"max-width: 1280px; margin: 0 auto; padding: 96px 48px; box-sizing: border-box; display: flex; flex-direction: column; gap: 40px;\"><div style=\"display: flex; flex-direction: column; gap: 16px; max-width: 860px;\"><div style=\"font-weight: 700; font-size: 14px; line-height: 1; letter-spacing: 0.14em; text-transform: uppercase; color: #041F33;\">Coming up</div><h2 style=\"margin: 0; font-family: 'PT Serif', Georgia, serif; font-weight: 700; color: #041F33; font-size: 44px; line-height: 1.16; letter-spacing: -0.02em;\">Where can I find Ricochet next?</h2></div>\n<ul style=\"list-style: none; margin: 0; padding: 0; display: flex; gap: 24px; align-items: stretch;\"><li style=\"flex: 1 1 0; min-width: 0; background: #FFFFFF; border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 10px 24px rgba(4,31,51,0.08);\">\n<img src=\"/wp-content/uploads/2026/10/csra-annual-meeting-graphic.webp\" alt=\"2026 CSRA Annual Meeting graphic.\" style=\"width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; display: block;\">\n<div style=\"padding: 24px 28px 28px; display: flex; flex-direction: column; gap: 10px; flex: 1;\">\n<span style=\"font-weight: 700; font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: #4B5563;\">November 19, 2026, 10 a.m. CT \u00b7 Conference session</span>\n<h3 style=\"margin: 0; font-family: 'PT Serif', Georgia, serif; font-weight: 700; color: #041F33; font-size: 25px; line-height: 1.22;\">From Busy Work to Better Work: Using AI to Increase Your Association's Capacity</h3>\n<p style=\"margin: 0; font-size: 18px; line-height: 1.5;\">2026 CSRA Annual Conference, Nashville, TN</p>\n<div style=\"margin-top: auto; padding-top: 10px;\"><a href=\"https://www.councilofsras.org/events/csra-2026-annual-meeting\" style=\"display: inline-block; background: #041F33; color: #FFFFFF; border-radius: 999px; padding: 13px 24px; font-weight: 700; font-size: 16px; text-decoration: none;\">Register</a></div></div></li><li style=\"flex: 1 1 0; min-width: 0; background: #FFFFFF; border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 10px 24px rgba(4,31,51,0.08);\">\n<div style=\"width: 100%; aspect-ratio: 3 / 2; background: #D6EAF4; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 18px;\"><img src=\"/wp-content/uploads/2026/10/association-academy-by-ricochet-logo-full-color.webp\" alt=\"Association Academy by Ricochet logo.\" style=\"width: 62%; height: auto; display: block;\"><div style=\"display: flex; gap: 14px; align-items: center;\"><img src=\"/wp-content/uploads/2026/10/cae-credential-badge.webp\" alt=\"CAE credential badge.\" style=\"width: 64px; height: 64px; display: block;\"><img src=\"/wp-content/uploads/2026/10/cem-credential-badge.webp\" alt=\"CEM credential badge.\" style=\"width: 64px; height: 64px; display: block;\"><img src=\"/wp-content/uploads/2026/10/cmp-credential-badge.webp\" alt=\"CMP credential badge.\" style=\"width: 64px; height: 64px; display: block;\"></div></div>\n<div style=\"padding: 24px 28px 28px; display: flex; flex-direction: column; gap: 10px; flex: 1;\">\n<span style=\"font-weight: 700; font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: #4B5563;\">Weekly \u00b7 Virtual</span>\n<h3 style=\"margin: 0; font-family: 'PT Serif', Georgia, serif; font-weight: 700; color: #041F33; font-size: 25px; line-height: 1.22;\">Professional Development Courses</h3>\n<p style=\"margin: 0; font-size: 18px; line-height: 1.5;\">CAE, CEM and CMP education from Association Academy by Ricochet, offered nearly every week of the year.</p>\n<div style=\"margin-top: auto; padding-top: 10px;\"><a href=\"/academy/\" style=\"display: inline-block; background: #041F33; color: #FFFFFF; border-radius: 999px; padding: 13px 24px; font-weight: 700; font-size: 16px; text-decoration: none;\">Explore courses</a></div></div></li></ul></div></section>\n<section style=\"background: #F0EBE3; font-family: 'PT Sans', -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; color: #333333;\"><div style=\"max-width: 1280px; margin: 0 auto; padding: 96px 48px; box-sizing: border-box; display: flex; flex-direction: column; gap: 40px;\"><div style=\"display: flex; flex-direction: column; gap: 16px; max-width: 860px;\"><div style=\"font-weight: 700; font-size: 14px; line-height: 1; letter-spacing: 0.14em; text-transform: uppercase; color: #041F33;\">Past events</div><h2 style=\"margin: 0; font-family: 'PT Serif', Georgia, serif; font-weight: 700; color: #041F33; font-size: 44px; line-height: 1.16; letter-spacing: -0.02em;\">Where has Ricochet been recently?</h2></div>\n<ul style=\"list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; align-items: stretch;\"><li style=\"min-width: 0; background: #FFFFFF; border-radius: 16px; overflow: hidden; padding: 22px 22px 2